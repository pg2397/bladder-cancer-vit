# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_meta
profile_default/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
.DS_Store
